{
  "kind": "collectionType",
  "collectionName": "ai_blogs",
  "info": {
    "singularName": "ai-blog",
    "pluralName": "ai-blogs",
    "displayName": "AiBlog",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "text"
    },
    "excerpt": {
      "type": "string"
    },
    "author": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::author.author"
    },
    "date": {
      "type": "datetime"
    },
    "readTime": {
      "type": "integer"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "featured": {
      "type": "boolean"
    },
    "slug": {
      "type": "string"
    },
    "coverImage": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    }
  }
}
